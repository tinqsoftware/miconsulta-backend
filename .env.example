ROBOT_CALL_CENATE_KEY=
ROBOT_CALL_TEST_PHONE=953761235
ROBOT_CALL_BRIDGE_POLL_SECONDS=10
ROBOT_CALL_BRIDGE_LEASE_SECONDS=120
ROBOT_CALL_BRIDGE_MAX_ATTEMPTS=5

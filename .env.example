# Bridge local: el VPS solo encola; el bridge de la laptop conecta con CENATE.
ROBOT_CALL_BRIDGE_ENABLED=false
ROBOT_CALL_CLOUD_URL=https://miconsulta.tinq.pe
ROBOT_CALL_CLOUD_TOKEN=

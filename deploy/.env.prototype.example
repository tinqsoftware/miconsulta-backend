APP_NAME="Mi Consulta"
APP_ENV=production
APP_KEY=REEMPLAZAR_CON_LA_LLAVE_DE_ARTISAN
APP_DEBUG=false
APP_URL=https://api.miconsulta.interno
APP_TIMEZONE=America/Lima
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=miconsulta_db
DB_USERNAME=miconsulta_app
DB_PASSWORD=REEMPLAZAR_CON_CLAVE_LARGA

MYSQL_DATABASE=miconsulta_db
MYSQL_USER=miconsulta_app
MYSQL_PASSWORD=REEMPLAZAR_CON_CLAVE_LARGA
MYSQL_ROOT_PASSWORD=REEMPLAZAR_CON_CLAVE_ROOT_LARGA

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

CERTIFICATES_ENABLED=true
CERTIFICATES_PROVIDER=telecertificacion
CERTIFICATES_DISK=certificates
CERTIFICATES_ROOT=/mnt/certificates
CERTIFICATES_FILENAME_PATTERN={dni}.pdf
TELECERTIFICACION_BASE_URL=http://10.0.1.189
# Configura UNA alternativa: token de integración permanente, o cuenta técnica
# de CENATE para obtener y renovar el Bearer temporal desde el backend.
TELECERTIFICACION_TOKEN=
TELECERTIFICACION_USERNAME=REEMPLAZAR_CON_USUARIO_TECNICO
TELECERTIFICACION_PASSWORD=REEMPLAZAR_CON_CLAVE_TECNICA
TELECERTIFICACION_TOKEN_CACHE_SECONDS=1200
TELECERTIFICACION_TIMEOUT_SECONDS=10
TELECERTIFICACION_MAX_PDF_BYTES=15728640

FIREBASE_CREDENTIALS=

# Secreto largo exclusivo entre Laravel y este servicio. No lo incluyas en Flutter.
ANITA_VOICE_TOKEN=CAMBIAR_POR_SECRETO_LARGO
ANITA_DEVICE=cuda:0
ANITA_QWEN_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
ANITA_ALIGN_MODEL=small
# Una síntesis a la vez en el piloto: mide antes de aumentar este número.
ANITA_MAX_CONCURRENT=1
# La referencia incluida es el audio institucional autorizado de CENATE.
ANITA_REFERENCE_AUDIO=/app/voices/anita-reference.mp3
ANITA_REFERENCE_TEXT="Qué gusto acompañarte mientras llega tu cita de Medicina General."
